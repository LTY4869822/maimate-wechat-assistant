{
  "manifest_version": 2,
  "id": "local.wechat-group-tools",
  "version": "1.0.0",
  "name": "微信群资料与表情库",
  "description": "查询已授权微信群的本地群资料，并将本机选定表情导入麦麦表情库。",
  "author": {"name": "本机部署", "url": "http://127.0.0.1:8001/"},
  "license": "MIT",
  "urls": {"repository": "http://127.0.0.1:8001/", "homepage": "http://127.0.0.1:8001/"},
  "host_application": {"min_version": "1.3.16", "max_version": "1.3.99"},
  "sdk": {"min_version": "2.16.0", "max_version": "2.16.99"},
  "capabilities": ["emoji.register", "emoji.get_all", "chat.get_group_streams", "message.get_recent", "maisaka.proactive.trigger", "send.text", "send.emoji", "llm.generate"],
  "dependencies": [{"type": "python_package", "name": "websockets", "version_spec": ">=16,<18"}, {"type": "python_package", "name": "Pillow", "version_spec": ">=10,<14"}],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
